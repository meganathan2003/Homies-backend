# change the env dev to prod in production
NODE_ENV=development
PORT=4000

# make is true
TRUST_PROXY=false
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=*

MONGODB_URI=mongodb://127.0.0.1:27017/homies
JWT_SECRET=your secret
JWT_EXPIRES_IN=7d

# make it false in prod
DEV_AUTH_BYPASS=true

# Admin login ku allowed emails (comma separated) you can change the email
ADMIN_EMAILS=meganathan212003@gmail.com

EXPERT_SHARE_PERCENT=60

# Firebase (Step 2)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay: dev la mock, production la live
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=mocksecret
RAZORPAY_WEBHOOK_SECRET=whsec_test

# Media storage: dev la local, production la s3
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_BASE_URL=

# Face verification (AWS Rekognition)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FACE_MIN_CONFIDENCE=0.75
FACE_REQUIRE_MALE=true



